{
  "name": "shape-drop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync": "vite build && npx cap sync",
    "android": "vite build && npx cap sync android && npx cap open android",
    "ios": "vite build && npx cap sync ios && npx cap open ios",
    "assets": "npx @capacitor/assets generate --android --ios --iconBackgroundColor '#1a1c2c' --iconBackgroundColorDark '#1a1c2c' --splashBackgroundColor '#1a1c2c' --splashBackgroundColorDark '#1a1c2c'"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.4.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "vite": "8.3.8"
  }
